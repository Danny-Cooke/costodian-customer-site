  "formats": {
    "email": {
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "message": "Enter an email address in the format name@example.com"
    },
    "phone": {
      "pattern": "^[0-9 +()-]{7,20}$",
      "message": "Enter a phone number using digits, spaces and + ( ) - only"
    },
    "sra_number": {
      "pattern": "^[0-9]{3,8}$",
      "message": "Enter the SRA number as digits only"
    },
    "company_number": {
      "pattern": "^[A-Za-z0-9]{8}$",
      "message": "Enter the 8 character company number"
    },
    "postcode": {
      "pattern": "^[A-Za-z]{1,2}[0-9][0-9A-Za-z]? ?[0-9][A-Za-z]{2}$",
      "message": "Enter a full UK postcode"
    },
    "vat_number": {
      "pattern": "^(GB)?[0-9]{9}$",
      "message": "Enter the 9 digit VAT number"
    },
    "url": {
      "pattern": "^(https?://)?[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(/\\S*)?$",
      "message": "Enter a website address"
    },
    "cl_number": {
      "pattern": "^[Cc][Ll] ?[0-9]{1,8}$",
      "message": "Enter the Costs Lawyer number, which starts with CL"
    },
    "ico_number": {
      "pattern": "^[A-Za-z]{1,2}[0-9A-Za-z]{6,8}$",
      "message": "Enter the registration number as it appears on the ICO register"
    }
  },
