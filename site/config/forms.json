{
  "messages": {
    "required": "Enter {label}",
    "required_choice": "Choose {label}",
    "required_tick": "Tick the box to continue",
    "pattern": "{label} is not in the expected format",
    "too_long": "{label} is too long",
    "number": "{label} must be a number",
    "too_small": "{label} must be {min} or more",
    "too_large": "{label} must be {max} or less",
    "summary_title": "There is a problem",
    "funding_required": "Choose at least one type of funding",
    "too_short": "Use at least {min_length} characters",
    "mismatch": "The two entries do not match",
    "option": "Choose {label} from the list",
    "invalid": "{label} is not valid",
    "auth_exists": "There is already an account for this email address. Sign in instead.",
    "auth_wrong": "The email address or password is not right",
    "auth_code_wrong": "That code is not right. Check the email and try again.",
    "auth_code_expired": "That code has expired. Ask for a new one.",
    "auth_password_weak": "Choose a stronger password: use upper and lower case letters, a number and a symbol",
    "auth_too_many": "Too many attempts. Wait a few minutes and try again.",
    "auth_failed": "Something went wrong signing you in. Try again.",
    "save_failed": "Your changes could not be saved. Try again.",
    "code_sent": "We have sent a code to your email address.",
    "reset_done": "Your password has been changed. Sign in with the new one.",
    "not_allowed": "Only an owner of the firm's account can do that.",
    "last_owner": "A firm's account must always have at least one owner.",
    "invite_exists": "That email address already has an account.",
    "invite_sent": "The invitation has been sent.",
    "member_removed": "That person can no longer manage the firm's account.",
    "role_changed": "The role has been changed.",
    "too_many_members": "There are too many people on this account.",
    "no_firm": "Your sign-in is not attached to a firm's account.",
    "auth_new_password": "Choose your own password to finish signing in.",
    "no_capacity": "We are setting up your account. Try again in a few minutes.",
    "version_older": "Choose the version you are on, or a newer one"
  },
  "formats": {
    "email": {
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "message": "Enter an email address in the format name@example.com"
    },
    "phone": {
      "pattern": "^[0-9 +()-]{7,20}$",
      "message": "Enter a phone number using digits, spaces and + ( ) - only"
    },
    "sra_number": {
      "pattern": "^[0-9]{3,8}$",
      "message": "Enter the SRA number as digits only"
    },
    "company_number": {
      "pattern": "^[A-Za-z0-9]{8}$",
      "message": "Enter the 8 character company number"
    },
    "postcode": {
      "pattern": "^[A-Za-z]{1,2}[0-9][0-9A-Za-z]? ?[0-9][A-Za-z]{2}$",
      "message": "Enter a full UK postcode"
    },
    "vat_number": {
      "pattern": "^(GB)?[0-9]{9}$",
      "message": "Enter the 9 digit VAT number"
    },
    "url": {
      "pattern": "^(https?://)?[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(/\\S*)?$",
      "message": "Enter a website address"
    }
  },
  "address_parts": [
    {
      "suffix": "line1",
      "label": "address line 1",
      "required": true,
      "autocomplete": "address-line1",
      "max_length": 120
    },
    {
      "suffix": "line2",
      "label": "address line 2",
      "required": false,
      "autocomplete": "address-line2",
      "max_length": 120
    },
    {
      "suffix": "town",
      "label": "town or city",
      "required": true,
      "autocomplete": "address-level2",
      "max_length": 80
    },
    {
      "suffix": "postcode",
      "label": "postcode",
      "required": true,
      "autocomplete": "postal-code",
      "format": "postcode",
      "max_length": 10
    }
  ],
  "signup": {
    "steps": [
      {
        "id": "you",
        "title": "About you",
        "intro": "You will be the first person who can sign in for your firm.",
        "fields": [
          {
            "id": "person_name",
            "label": "full name",
            "type": "text",
            "required": true,
            "autocomplete": "name",
            "max_length": 120
          },
          {
            "id": "person_role",
            "label": "role at the firm",
            "type": "select",
            "required": true,
            "options": [
              {
                "value": "partner",
                "label": "Partner or director"
              },
              {
                "value": "solicitor",
                "label": "Solicitor"
              },
              {
                "value": "consultant",
                "label": "Consultant solicitor"
              },
              {
                "value": "practice_manager",
                "label": "Practice manager"
              },
              {
                "value": "biller",
                "label": "Biller or costs draftsman"
              },
              {
                "value": "other",
                "label": "Other"
              }
            ]
          },
          {
            "id": "person_email",
            "label": "work email address",
            "type": "email",
            "required": true,
            "format": "email",
            "autocomplete": "email",
            "max_length": 254,
            "help": "This becomes your sign-in."
          },
          {
            "id": "person_phone",
            "label": "phone number",
            "type": "tel",
            "required": true,
            "format": "phone",
            "autocomplete": "tel"
          },
          {
            "id": "person_sra_number",
            "label": "your own SRA number",
            "type": "text",
            "required": false,
            "format": "sra_number",
            "inputmode": "numeric",
            "help": "Optional. Only if you are a solicitor."
          }
        ],
        "profile": true,
        "scope": "person"
      },
      {
        "id": "firm",
        "title": "Your firm",
        "intro": "The firm that will hold the account.",
        "fields": [
          {
            "id": "firm_name",
            "label": "firm name",
            "type": "text",
            "required": true,
            "autocomplete": "organization",
            "max_length": 160,
            "help": "As it appears on the SRA register."
          },
          {
            "id": "firm_trading_name",
            "label": "trading name",
            "type": "text",
            "required": false,
            "max_length": 160,
            "help": "Optional. Only if it differs from the firm name."
          },
          {
            "id": "firm_sra_number",
            "label": "firm SRA number",
            "type": "text",
            "required": true,
            "format": "sra_number",
            "inputmode": "numeric"
          },
          {
            "id": "firm_type",
            "label": "type of firm",
            "type": "select",
            "required": true,
            "options": [
              {
                "value": "sole_practice",
                "label": "Sole practice"
              },
              {
                "value": "partnership",
                "label": "Partnership"
              },
              {
                "value": "llp",
                "label": "Limited liability partnership (LLP)"
              },
              {
                "value": "limited",
                "label": "Limited company"
              }
            ]
          },
          {
            "id": "firm_company_number",
            "label": "company number",
            "type": "text",
            "required": true,
            "format": "company_number",
            "show_if": {
              "field": "firm_type",
              "in": [
                "llp",
                "limited"
              ]
            }
          },
          {
            "id": "firm_office",
            "label": "Office address",
            "type": "address",
            "required": true
          },
          {
            "id": "firm_correspondence_same",
            "label": "Send post to the office address",
            "type": "checkbox",
            "required": false,
            "default": true
          },
          {
            "id": "firm_correspondence",
            "label": "Correspondence address",
            "type": "address",
            "required": true,
            "show_if": {
              "field": "firm_correspondence_same",
              "equals": false
            }
          },
          {
            "id": "firm_website",
            "label": "website",
            "type": "text",
            "required": false,
            "format": "url",
            "autocomplete": "url",
            "max_length": 200,
            "help": "Optional."
          }
        ],
        "profile": true,
        "scope": "firm"
      },
      {
        "id": "signin",
        "title": "Your sign-in",
        "requires": "auth",
        "intro": "You will sign in with your email address and this password.",
        "fields": [
          {
            "type": "password",
            "secret": true,
            "required": true,
            "min_length_key": "auth.password_min_length",
            "max_length": 200,
            "id": "person_password",
            "label": "password",
            "autocomplete": "new-password",
            "help": "Use upper and lower case letters, a number and a symbol."
          },
          {
            "id": "person_password_again",
            "label": "password again",
            "type": "password",
            "secret": true,
            "required": true,
            "autocomplete": "new-password",
            "matches": "person_password",
            "max_length": 200
          }
        ]
      },
      {
        "id": "confirm",
        "title": "Confirm",
        "intro": "Check your details, then confirm.",
        "fields": [
          {
            "id": "payment_note",
            "type": "note",
            "label": "Payment",
            "text": "Card payment will be taken here when sign-up opens, on our payment provider's own page. We never see or store card numbers. No payment is taken in this preview.",
            "requires": "payment"
          },
          {
            "id": "confirm_authorised",
            "label": "I am authorised to sign this firm up",
            "type": "checkbox",
            "required": true
          }
        ],
        "title_when": {
          "payment": "Payment and confirm"
        }
      }
    ]
  },
  "company": {
    "sections": [
      {
        "id": "billing",
        "title": "Billing set-up",
        "intro": "These appear on every bill the product drafts.",
        "fields": [
          {
            "id": "laa_account_number",
            "label": "LAA account number",
            "type": "text",
            "required": true,
            "max_length": 20,
            "show_if": {
              "field": "funding_legal_aid",
              "equals": true
            }
          },
          {
            "id": "office_region",
            "label": "office region",
            "type": "radio",
            "required": true,
            "help": "This sets which legal aid hourly rates apply.",
            "options": [
              {
                "value": "London",
                "label": "London"
              },
              {
                "value": "Non-London",
                "label": "Outside London"
              }
            ]
          },
          {
            "id": "vat_registered",
            "label": "The firm is registered for VAT",
            "type": "checkbox",
            "required": false,
            "default": true
          },
          {
            "id": "vat_number",
            "label": "VAT number",
            "type": "text",
            "required": true,
            "format": "vat_number",
            "show_if": {
              "field": "vat_registered",
              "equals": true
            }
          },
          {
            "id": "bills_per_month",
            "label": "rough number of bills a month",
            "type": "number",
            "required": false,
            "min": 0,
            "max": 5000,
            "help": "Optional. A guess is fine."
          },
          {
            "id": "invoice_contact_name",
            "label": "invoice contact name",
            "type": "text",
            "required": false,
            "max_length": 120,
            "help": "Optional. Leave blank to send invoices to you."
          },
          {
            "id": "invoice_contact_email",
            "label": "invoice contact email",
            "type": "email",
            "required": false,
            "format": "email",
            "max_length": 254
          }
        ]
      },
      {
        "id": "version",
        "title": "Version",
        "intro": "The version of the product your firm's account runs. You can move to a newer one when it is available.",
        "fields": [
          {
            "id": "product_version",
            "label": "version",
            "type": "select",
            "required": true,
            "options_from": "versions"
          }
        ]
      }
    ],
    "funding": {
      "title": "Types of funding",
      "intro": "Choose the kinds of case your firm will use the product for. You only fill in the sections for the ones you choose.",
      "fields": [
        {
          "id": "funding_legal_aid",
          "label": "Legal aid cases",
          "type": "checkbox",
          "required": false,
          "default": true
        },
        {
          "id": "funding_private",
          "label": "Privately funded cases",
          "type": "checkbox",
          "required": false,
          "default": false
        }
      ]
    }
  },
  "agreement": {
    "fields": [
      {
        "id": "accept_name",
        "label": "your full name",
        "type": "text",
        "required": true,
        "autocomplete": "name",
        "max_length": 120
      },
      {
        "id": "accept_tick",
        "label": "I have read the agreement and accept it on behalf of the firm",
        "type": "checkbox",
        "required": true
      }
    ]
  },
  "verify": {
    "fields": [
      {
        "type": "text",
        "required": true,
        "inputmode": "numeric",
        "autocomplete": "one-time-code",
        "max_length": 10,
        "pattern": "^[0-9]{6}$",
        "pattern_message": "Enter the 6 digit code from the email",
        "id": "verify_code",
        "label": "the code from the email"
      }
    ]
  },
  "signin": {
    "fields": [
      {
        "type": "email",
        "required": true,
        "format": "email",
        "autocomplete": "email",
        "max_length": 200,
        "id": "signin_email",
        "label": "email address"
      },
      {
        "id": "signin_password",
        "label": "password",
        "type": "password",
        "secret": true,
        "required": true,
        "autocomplete": "current-password",
        "max_length": 200
      }
    ]
  },
  "reset": {
    "request": [
      {
        "type": "email",
        "required": true,
        "format": "email",
        "autocomplete": "email",
        "max_length": 200,
        "id": "reset_email",
        "label": "email address"
      }
    ],
    "confirm": [
      {
        "type": "text",
        "required": true,
        "inputmode": "numeric",
        "autocomplete": "one-time-code",
        "max_length": 10,
        "pattern": "^[0-9]{6}$",
        "pattern_message": "Enter the 6 digit code from the email",
        "id": "reset_code",
        "label": "the code from the email"
      },
      {
        "type": "password",
        "secret": true,
        "required": true,
        "min_length_key": "auth.password_min_length",
        "max_length": 200,
        "id": "reset_password",
        "label": "new password",
        "autocomplete": "new-password",
        "help": "Use upper and lower case letters, a number and a symbol."
      },
      {
        "id": "reset_password_again",
        "label": "new password again",
        "type": "password",
        "secret": true,
        "required": true,
        "autocomplete": "new-password",
        "matches": "reset_password",
        "max_length": 200
      }
    ]
  },
  "people": {
    "invite": [
      {
        "id": "invite_email",
        "label": "email address",
        "type": "email",
        "required": true,
        "format": "email",
        "autocomplete": "off",
        "max_length": 200
      },
      {
        "id": "invite_role",
        "label": "role",
        "type": "radio",
        "required": true,
        "options_key": "roles",
        "default_key": "default_invite_role"
      }
    ]
  },
  "new_password": {
    "fields": [
      {
        "type": "password",
        "secret": true,
        "required": true,
        "min_length_key": "auth.password_min_length",
        "max_length": 200,
        "id": "new_password",
        "label": "new password",
        "autocomplete": "new-password",
        "help": "Use upper and lower case letters, a number and a symbol."
      },
      {
        "id": "new_password_again",
        "label": "new password again",
        "type": "password",
        "secret": true,
        "required": true,
        "autocomplete": "new-password",
        "matches": "new_password",
        "max_length": 200
      }
    ]
  }
}
