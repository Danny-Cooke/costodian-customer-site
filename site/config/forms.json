  "signup": {
    "steps": [
      {
        "id": "type",
        "title": "Account type",
        "profile": true,
        "scope": "firm",
        "intro": "Choose what describes you. The questions that follow are the ones for that kind of account.",
        "fields": [
          {
            "id": "account_type",
