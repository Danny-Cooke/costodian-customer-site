              },
              {
                "value": "solicitor",
                "label": "Solicitor"
              },
              {
                "value": "consultant",
                "label": "Consultant solicitor"
              },
              {
                "value": "practice_manager",
                "label": "Practice manager"
              },
              {
                "value": "biller",
                "label": "Biller or costs draftsman"
              },
              {
                "value": "other",
                "label": "Other"
              }
            ]
          },
          {
            "id": "person_email",
            "label": "work email address",
            "type": "email",
            "required": true,
            "format": "email",
            "autocomplete": "email",
            "max_length": 254,
            "help": "This becomes your sign-in."
          },
          {
            "id": "person_phone",
            "label": "phone number",
            "type": "tel",
            "required": true,
            "format": "phone",
            "autocomplete": "tel"
          },
          {
            "id": "person_sra_number",
